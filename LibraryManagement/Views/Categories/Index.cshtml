@using LibraryManagement.Model
@model List<Category>

<table class="table table-bordered table-striped table-hover">
    <thead class="table table-dark">
        <tr>
            <th>Id</th>
            <th>CategoryName</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr >
                <td>@category.Id</td>
                <td>@category.CategoryName</td>
            </tr>
        }
    </tbody>
</table>