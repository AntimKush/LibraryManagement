@using LibraryManagement.Model
@model List<Author>
<table class="table table-bordered table-striped table-hover" id="authortable">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>AuthorName</th>
            <th>Added By</th>
            <th>Added On</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.Id</td>
                <td>@author.AuthorName</td>
                <td>@author.AddedBy</td>
                <td>@author.AddedOn</td>
            </tr>
        }
    </tbody>
</table>

@section scripts{
    <script>
        $(document).ready(function(){
            $('#authortable').DataTable({
                "paging":true,
                "pageLength": 5,
                "language":{
                    "search":"Filter records:"
                }
            });
        });
        
    </script>
}
