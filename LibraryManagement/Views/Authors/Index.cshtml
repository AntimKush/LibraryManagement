@using LibraryManagement.Model
@model List<Author>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>AuthorName</th>
            <th>Added By</th>
            <th>Added On</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.Id</td>
                <td>@author.AuthorName</td>
                <td>@author.AddedBy</td>
                <td>@author.AddedOn</td>
            </tr>
        }
    </tbody>
</table>