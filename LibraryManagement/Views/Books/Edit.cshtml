@using LibraryManagement.Model;
@model Book
<form method="post">
    <input type="hidden" asp-for="Id" />
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>

                <th>BookName</th>
                <th>AuthorName</th>
                <th>Category</th>
                <th>ISBN</th>
                <th>Price</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input type="text" class="form-control" asp-for="BookName" /></td>
                

                <td>
                    <select class="form-select" asp-for="AuthorId" asp-items="@ViewBag.authors">
                        <option value="">-- Select Author --</option>

                    </select>
                </td>
                <td>
                    <select class="form-select" asp-for="CategoryId" asp-items="@ViewBag.category">
                        <option value="" >--select Category---</option>
                    </select>
                </td>
              
                <td><input type="text" class="form-control" asp-for="ISBN" /></td>
                <td><input type="text" class="form-control" asp-for="Price" /></td>
                <td><input type="text" class="form-control" asp-for="Quantity" /></td>
            </tr>
        </tbody>
    </table>
    <input type="submit" value="UPDATE" class="btn btn-success" />
</form>

@if (ViewBag.response != null)
{
    @if (ViewBag.response.IsSuccess)
    {
        <div class="alert alert-success">@ViewBag.response.Message</div>
    }
    else
    {
        <div class="alert alert-danger">@ViewBag.response.Message</div>
    }
}


